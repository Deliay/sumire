+++ b/dist/mpegts-byte-offset-seek.js
@@ -0,0 +1,150 @@
+/*
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * ============================================================================
+ * 录播优化一期补丁（sumire）
+ * ----------------------------------------------------------------------------
+ * 1) 暴露「按字节偏移续播」能力（seekToByteOffset），用于 FLV 无关键帧索引时的近似 seek。
+ *
+ * 背景：上游录播 FLV（录制端直接 dump）的 onMetaData 不含 keyframes 索引，
+ * 导致 MediaInfo.isSeekable() === false；而 TransmuxingController.seek() 首行即
+ * `if (this._mediaInfo == null || !this._mediaInfo.isSeekable()) return;`，未缓冲
+ * seek 因此静默 no-op，触发 mpegts 每 50ms 的未缓冲 seek 校正死循环（整体卡死）。
+ *
+ * 方案：在 createPlayer 返回的播放器实例上暴露
+ *   player.seekToByteOffset(fileposition, milliseconds)
+ * 它绕过 isSeekable() 门，从指定字节偏移继续加载（`_loadSegment(0, fileposition)`），
+ * remuxer 以期望的 milliseconds 作为时间基准并经 RECOMMEND_SEEKPOINT 回写 currentTime。
+ *
+ * lazyLoad 暂停死锁兜底（关键）：
+ * LoadingController（src/player/loading-controller.ts）在**任意** MEDIA_SEGMENT（音频也算）
+ * 到达时按 `buffered_end >= currentTime + lazyLoadMaxDuration` 暂停 transmuxer；而
+ * TransmuxingController._onRemuxerMediaSegmentArrival 的顺序是「先发 MEDIA_SEGMENT（触发暂停
+ * 判定）再发 RECOMMEND_SEEKPOINT（才回写 currentTime）」。续播时旧缓冲已 flush、currentTime
+ * 仍停在旧位置，若首个到达段为音频则 IO 被暂停，而恢复条件 `_resumeTransmuxerIfNeeded`
+ * 要求 currentTime 落在某 buffered 区间内（此刻为新时间轴、currentTime 在旧位置）→ 永假 →
+ * IO 永不恢复、首个视频关键帧永不到达、RECOMMEND_SEEKPOINT 永不触发 → 整体冻死。
+ * 兜底措施：
+ *   a) seek 期间临时置 `engine._config.lazyLoad = false`，使 LoadingController 完全跳过暂停判定；
+ *      在 RECOMMEND_SEEKPOINT 到达（或超时兜底）后恢复；
+ *   b) 通过 `_seeking_handler.directSeek(target)` 立即把 `currentTime` 对齐到新时间轴
+ *      （与 accurateSeek 行为一致，且避免被 SeekingHandler 误当作浏览器端 seek 再触发校正）。
+ * 应用层同时优先对齐到视频关键帧 tag（apps/bookstore/features/recordings/seek.ts）以进一步
+ * 保证首个媒体段为 video、画面尽快恢复。
+ *
+ * 调用方约束：fileposition 必须对齐到 FLV tag 边界（demuxer 无 mid-stream resync），
+ * 由应用层扫描保证。主线程引擎缺失（如开启 enableWorkerForMSE）时抛错，由应用层捕获后
+ * 显性提示，不得静默冻结。
+ *
+ * 2) 暴露「运行时调整缓冲上限」能力（setBufferLimits），供应用层按
+ *    size/duration 估算码率后把前瞻/回退缓冲折算到确定性字节预算（合计 ≤50MB）。
+ * ============================================================================
+ */
+'use strict';
+
+const mpegts = require('./mpegts.js');
+
+// lazyLoad 兜底恢复的超时上限（ms）：RECOMMEND_SEEKPOINT 未到达时也必须恢复，避免长期关闭懒加载
+const LAZY_LOAD_GUARD_TIMEOUT_MS = 20000;
+
+function installLazyLoadGuard(transmuxer, config) {
+  if (!config) {
+    return function noop() {};
+  }
+  const previous = config.lazyLoad;
+  config.lazyLoad = false;
+
+  let finished = false;
+  let timer = null;
+  const finish = () => {
+    if (finished) return;
+    finished = true;
+    config.lazyLoad = previous;
+    if (transmuxer && typeof transmuxer.off === 'function') {
+      transmuxer.off('recommend_seekpoint', finish);
+    }
+    if (timer !== null) {
+      clearTimeout(timer);
+      timer = null;
+    }
+  };
+
+  if (transmuxer && typeof transmuxer.on === 'function') {
+    transmuxer.on('recommend_seekpoint', finish);
+    if (typeof setTimeout === 'function') {
+      timer = setTimeout(finish, LAZY_LOAD_GUARD_TIMEOUT_MS);
+      if (timer && typeof timer.unref === 'function') timer.unref();
+    }
+  }
+  return finish;
+}
+
+function applyByteOffsetSeek(player, fileposition, milliseconds) {
+  const engine = player && player._player_engine;
+  const transmuxer = engine && engine._transmuxer;
+  const controller = transmuxer && transmuxer._controller;
+  if (!engine || !controller || typeof controller._loadSegment !== 'function') {
+    throw new Error('mpegts.js byte-offset seek is unavailable: unexpected internal structure (worker mode or unpatched build)');
+  }
+
+  // 防 lazyLoad 暂停死锁：seek 期间关闭懒加载，直到 RECOMMEND_SEEKPOINT 到达 / 超时兜底
+  const restoreLazyLoad = installLazyLoadGuard(transmuxer, engine._config);
+
+  try {
+    // 与 PlayerEngineMainThread._onRequiredUnbufferedSeek 一致：先 flush MSE 旧缓冲
+    if (engine._mse_controller && typeof engine._mse_controller.flush === 'function') {
+      engine._mse_controller.flush();
+    }
+    controller._internalAbort();
+    if (controller._remuxer) {
+      controller._remuxer.seek(milliseconds);
+      controller._remuxer.insertDiscontinuity();
+    }
+    controller._loadSegment(0, fileposition);
+    controller._pendingResolveSeekPoint = milliseconds;
+
+    // 立即对齐时间轴：使 LoadingController 的暂停判定基准与新数据一致
+    const seconds = milliseconds / 1000;
+    if (engine._seeking_handler && typeof engine._seeking_handler.directSeek === 'function') {
+      engine._seeking_handler.directSeek(seconds);
+    } else if (engine._media_element) {
+      engine._media_element.currentTime = seconds;
+    }
+  } catch (error) {
+    restoreLazyLoad();
+    throw error;
+  }
+}
+
+const originalCreatePlayer = mpegts.createPlayer;
+
+mpegts.createPlayer = function createPlayer(mediaDataSource, config) {
+  const player = originalCreatePlayer.call(this, mediaDataSource, config);
+  if (!player) return player;
+
+  if (typeof player.seekToByteOffset !== 'function') {
+    player.seekToByteOffset = function seekToByteOffset(fileposition, milliseconds) {
+      applyByteOffsetSeek(this, fileposition, milliseconds);
+    };
+  }
+
+  if (typeof player.setBufferLimits !== 'function') {
+    player.setBufferLimits = function setBufferLimits(limits) {
+      const engine = this._player_engine;
+      if (engine && engine._config && limits) {
+        Object.assign(engine._config, limits);
+      }
+    };
+  }
+
+  return player;
+};
+
+// 供测试直接校验 seek 防死锁逻辑（不改变对外 API）
+mpegts.__sumireApplyByteOffsetSeek = applyByteOffsetSeek;
+
+module.exports = mpegts;
